AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=databricks-airflow:local
AIRFLOW_BASE_IMAGE=apache/airflow:3.1.8
AIRFLOW_VERSION=3.1.8
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow
REDIS_PASSWORD=change_me_redis_password
AIRFLOW__CORE__FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_secure_jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
_AIRFLOW_WWW_USER_USERNAME=replace_with_admin_username
_AIRFLOW_WWW_USER_PASSWORD=replace_with_strong_admin_password

# Keep FAB auth in production unless your security team approves an alternative.
AIRFLOW__CORE__AUTH_MANAGER=airflow.providers.fab.auth_manager.fab_auth_manager.FabAuthManager

# Optional: external secrets backend (recommended for production).
# Example AWS Secrets Manager:
# AIRFLOW__SECRETS__BACKEND=airflow.providers.amazon.aws.secrets.secrets_manager.SecretsManagerBackend
# AIRFLOW__SECRETS__BACKEND_KWARGS={"connections_prefix":"airflow/connections","variables_prefix":"airflow/variables","region_name":"us-east-1"}
AIRFLOW__SECRETS__BACKEND=
AIRFLOW__SECRETS__BACKEND_KWARGS=

AIRFLOW_CONN_DATABRICKS_DEFAULT=databricks://:replace_with_databricks_pat@dbc-xxxxxxxx.cloud.databricks.com
DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
DATABRICKS_TOKEN=replace_with_databricks_pat_with_sql_scope
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/replace_me
DATABRICKS_CATALOG=crypto-data-pipeline
DATABRICKS_SCHEMA=bronze
DATABRICKS_TABLE=coingecko_market_data

DBT_TARGET=prod
DBT_TARGET_SCHEMA=silver
